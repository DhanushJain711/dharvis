TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_ID=your_telegram_user_id
# Use polling locally and on Railway. Azure App Service uses webhook mode.
RUN_MODE=polling
TELEGRAM_POLL_TIMEOUT_SECONDS=30
# Webhook mode only: public HTTPS origin (no path), plus independently generated
# URL path and Telegram header secret. Generate placeholders with
# `python scripts/gen_webhook_secrets.py`; do not commit real values.
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_PATH=
TELEGRAM_WEBHOOK_SECRET=

OPENAI_API_KEY=your_openai_api_key
AGENT_MODEL_ID=gpt-5.6-terra
SUMMARY_MODEL_ID=gpt-5.6-luna
SCHEDULER_MODEL_ID=gpt-5.6-terra
FACTS_MODEL_ID=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

USER_TIMEZONE=America/Chicago
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
DAILY_BRIEF_TIME=07:30
DAILY_DEBRIEF_TIME=20:30
WEEKLY_REVIEW_TIME=20:30
REASONING_VERBOSITY=brief

# All mutable state defaults beneath DATA_DIR. Set this single directory on a
# persistent volume; explicit paths below are optional overrides for unusual layouts.
DATA_DIR=./data
# GOOGLE_CALENDAR_CREDENTIALS_PATH=./data/credentials.json
# GOOGLE_CALENDAR_TOKEN_PATH=./data/token.json
GOOGLE_CALENDAR_TOKEN_BASE64=
GOOGLE_CALENDAR_ID=primary
KALENDRA_CALENDAR_NAME=Kalendra
KALENDRA_CALENDAR_ID=

# DATABASE_PATH=./data/dharvis.db
# APSCHEDULER_DATABASE_PATH=./data/dharvis.db.jobs.sqlite
MESSAGE_HISTORY_LIMIT=100
DEFAULT_TASK_MINUTES=30
SCHEDULER_LOOKAHEAD_DAYS=14
HEALTH_PORT=0

# Temporary compatibility only while src.claude_agent is retired.
ANTHROPIC_API_KEY=
